# Copy this to .streamlit/secrets.toml (gitignored) or add to Streamlit Cloud secrets
# Streamlit Cloud: App settings → Secrets → paste the contents of your settings.toml here

[telegram]
bot_token = "YOUR_BOT_TOKEN"
chat_id   = "YOUR_CHAT_ID"

[ollama]
model        = "llama3.1:8b"
vision_model = "llava"
base_url     = "http://localhost:11434"
